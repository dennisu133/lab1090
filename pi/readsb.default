# readsb configuration -- sourced by /usr/lib/systemd/system/readsb.service
#
# Role of this Pi: a "dumb" receiver. It demodulates 1090 MHz, CRC-checks the
# frames and streams them raw. All decoding/tracking happens on the PC.

# The SDR: first RTL-SDR, readsb's built-in auto gain, no frequency correction.
RECEIVER_OPTIONS="--device 0 --device-type rtlsdr --gain auto --ppm 0"

# No receiver location on purpose -- position decoding happens on the PC.
DECODER_OPTIONS=""

# Outputs (TCP servers, the PC connects to them):
#   30005  Beast binary: raw frame + 12 MHz timestamp + signal level  (main feed)
#   30002  AVR raw hex text "*8D...;"                                  (for eyeballing with nc)
# Every other port defaults to 0 = off. readsb listens on all interfaces;
# use --net-bind-address 127.0.0.1 to restrict it to the Pi itself.
# --net-heartbeat 60: send a keepalive frame every 60 s so idle connections stay open.
NET_OPTIONS="--net --net-bo-port 30005 --net-ro-port 30002 --net-heartbeat 60"

# The service always writes a few status JSON files to /run/readsb (a RAM disk).
# That's harmless, and we add nothing on top.
JSON_OPTIONS=""
