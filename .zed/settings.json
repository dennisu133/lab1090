				}
			}
		},
		"JSONC": {
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--no-script", "--stdin-filepath", "{buffer_path}"]
				}
			}
		},
		"Markdown": {
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--no-script", "--stdin-filepath", "{buffer_path}"]
				}
			}
		}
	}
}
