# Copy to .env and adjust. Only RECEIVER_POSITION is required; .env itself stays out of git.

# Host running readsb with Beast output, and its port.
RECEIVER_HOST=pi
RECEIVER_PORT=30005

# Required: where the antenna is, "latitude,longitude" in decimal degrees (north/east
# positive), as exact as you can (~100 m). See "Receiver position" in the README.
RECEIVER_POSITION=51.5,-0.1
