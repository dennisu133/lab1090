# Copy to .env and adjust. Everything is optional; .env itself stays out of git.

# Host running readsb with Beast output, and its port.
RECEIVER_HOST=pi
RECEIVER_PORT=30005

# Where the antenna is, "latitude,longitude" in decimal degrees (north/east positive).
# Lets the app decode a position from a single ADS-B message (it only has to be within
# ~150 NM for that), measure distances from the antenna and draw it on the map.
RECEIVER_POSITION=51.5,-0.1
