# Copy to .env and adjust. Everything is optional; .env itself stays out of git.

# Host running readsb with Beast output, and its port.
RECEIVER_HOST=pi
RECEIVER_PORT=30005

# A point near the receiver, "latitude,longitude" in decimal degrees (north/east positive).
# Lets /frames decode a position from a single ADS-B message. One decimal is plenty: it only
# has to be within ~150 NM of the aircraft.
REFERENCE_POINT=51.5,-0.1
