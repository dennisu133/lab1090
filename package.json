{
	"name": "lab1090",
	"version": "0.0.1",
	"description": "See and understand what aircraft transmit on 1090 MHz: live Mode S and ADS-B decoding from raw RTL-SDR samples.",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dennisu133/lab1090.git"
	},
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev --",
		"build": "bun --bun vite build",
		"build:binary": "COMPILE=native bun --bun vite build",
		"build:arm64": "COMPILE=bun-linux-arm64 bun --bun vite build",
		"build:demo": "bun --bun vite build --mode demo && cp -r demo-data build-demo/demo",
		"dev:demo": "bun --bun vite dev --mode demo --",
		"deploy:demo": "bun run build:demo && bunx wrangler deploy",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"lint": "bun fmt --check && eslint .",
		"format": "bun fmt",
		"test:watch": "bun test --watch"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-bun": "^1.0.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.5",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.6",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"flag-icons": "^7.6.0",
		"globals": "^17.14.0",
		"maplibre-gl": "^6.19.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8"
	},
	"patchedDependencies": {
		"@sveltejs/adapter-bun@1.0.2": "patches/@sveltejs%2Fadapter-bun@1.0.2.patch"
	}
}
