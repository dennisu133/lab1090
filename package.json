{
	"name": "lab1090",
	"version": "0.0.1",
	"description": "A learning tool for what aircraft transmit on 1090 MHz: decodes live Mode S and ADS-B from an RTL-SDR, from the raw samples up, and explains every value",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dennisu133/lab1090.git"
	},
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev --",
		"build": "bun --bun vite build",
		"build:binary": "COMPILE=native bun --bun vite build",
		"build:arm64": "COMPILE=bun-linux-arm64 bun --bun vite build",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"lint": "bun fmt --check && eslint .",
		"format": "bun fmt",
		"test:watch": "bun test --watch"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-bun": "^1.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.4",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"flag-icons": "^7.6.0",
		"globals": "^17.6.0",
		"maplibre-gl": "^6.18.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	}
}
